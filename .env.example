# =====================================================================
#  CDS pricing platform — environment template.
#  Copy to .env (or run `python scripts/gen-env.py`, which fills every
#  __GENERATE__ with a random secret). Never commit .env.
# =====================================================================

# ---------------------------------------------------------------------
# Public endpoint (what users type into the browser)
# ---------------------------------------------------------------------
CDS_PUBLIC_URL=http://localhost:8080
GATEWAY_PORT=8080
# Business timezone: schedules, "today" for curves
CDS_TIMEZONE=Europe/Moscow

# ---------------------------------------------------------------------
# Corporate contour: registry mirrors and outbound proxy.
# Defaults point to the public internet.
# ---------------------------------------------------------------------
# Docker Hub mirror, e.g. nexus.corp.local:8443/dockerhub or harbor.corp.local/dockerhub-proxy
DOCKERHUB_MIRROR=docker.io
# quay.io mirror (Keycloak image lives there)
QUAY_MIRROR=quay.io
# PyPI mirror, e.g. https://nexus.corp.local/repository/pypi-proxy/simple
PIP_INDEX_URL=https://pypi.org/simple
# Set to the mirror host if it uses a self-signed certificate
PIP_TRUSTED_HOST=
# npm mirror, e.g. https://nexus.corp.local/repository/npm-proxy/
NPM_REGISTRY=https://registry.npmjs.org/
# Outbound HTTP(S) proxy for image builds and containers. Leave empty if not needed:
# when every dependency comes from internal mirrors, the build needs no proxy at all.
# The proxy must be reachable from INSIDE containers (127.0.0.1 there is the container
# itself; for a proxy running on your machine use host.docker.internal).
HTTP_PROXY=
HTTPS_PROXY=
# Hosts reached directly, bypassing the proxy. Must contain every compose service AND
# your internal mirrors (domain suffix with a leading dot, e.g. ,.corp.local), otherwise
# pip/npm send mirror requests to the proxy.
NO_PROXY=localhost,127.0.0.1,postgres,keycloak,elasticsearch,admin,curves,curves-worker,credit,credit-worker,scheduler,shell,mfe-admin,mfe-curves,mfe-credit,gateway,fluent-bit

# Our own images are named ${CDS_IMAGE_PREFIX}/cds-<service>:${CDS_VERSION}.
# Local builds: keep "local". Prebuilt images (docs/deploy-prebuilt-images.md):
#   publishing machine: CDS_IMAGE_PREFIX=docker.io/<dockerhub-user>
#   corporate machine:  CDS_IMAGE_PREFIX=<DOCKERHUB_MIRROR>/<dockerhub-user>
CDS_IMAGE_PREFIX=local
CDS_VERSION=0.7.1

# ---------------------------------------------------------------------
# PostgreSQL (one database, one schema per service)
# ---------------------------------------------------------------------
POSTGRES_DB=cds
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
DB_PASSWORD_KEYCLOAK=__GENERATE__
DB_PASSWORD_ADMIN=__GENERATE__
DB_PASSWORD_CURVES=__GENERATE__
DB_PASSWORD_CREDIT=__GENERATE__

# ---------------------------------------------------------------------
# Moscow Exchange ISS (bonds for credit curves). The credit service needs outbound
# HTTPS to iss.moex.com — through HTTPS_PROXY above in the corporate contour.
# ---------------------------------------------------------------------
ISS_BASE_URL=https://iss.moex.com/iss
# iss.moex.com uses a Russian Trusted CA certificate: its root is built into the credit image.
# Proxy re-signs TLS with a corporate CA: mount the CA file into the credit containers and
# point ISS_CA_BUNDLE at it (added to the trusted CAs), or switch ISS_BASE_URL to http://iss.moex.com/iss
ISS_CA_BUNDLE=
ISS_REQUESTS_PER_SECOND=4
# Free ISS market data are delayed by 15 minutes (0 with a real-time subscription)
ISS_DELAY_MINUTES=15

# ---------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------
# Master-realm admin (Keycloak console at /auth/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__
# Secret of the confidential client used by the admin service
KC_BACKEND_CLIENT_SECRET=__GENERATE__
# First CDS administrator (realm "cds"). Password is temporary: Keycloak asks to change it.
CDS_BOOTSTRAP_ADMIN_USERNAME=admin
CDS_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__

# ---------------------------------------------------------------------
# Logs (Elasticsearch + Fluent Bit)
# ---------------------------------------------------------------------
ES_JAVA_OPTS="-Xms512m -Xmx512m"
LOG_RETENTION_DAYS=7
FLUENTBIT_PORT=24224
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Invitations (magic links for the first login)
# ---------------------------------------------------------------------
INVITE_TTL_DAYS=7
