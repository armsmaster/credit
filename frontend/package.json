{
  "name": "cds-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "CDS pricing UI: shell (host) + microfrontends (Module Federation)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/shell -w apps/mfe-admin -w apps/mfe-curves",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "echarts": "5.5.1",
    "element-plus": "2.9.1",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "1.3.6",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vue-tsc": "2.1.10"
  }
}
